# docker-compose override env file. Copy to .env and adjust per host.

# ---- Django core ------------------------------------------------------------
SECRET_KEY=replace-this-with-a-strong-django-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.production
PORT=8000

# Sessions/cookies disabled because nginx terminates HTTP in this stack.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ---- Database & cache -------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@db:5432/fitforge
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---- NVIDIA NIM -------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=verbose
