# =============================================================================
# FitForge – production environment variables
# =============================================================================
# Copy to ``.env`` (local dev) or inject via your platform's secret store
# (Kuberns secrets, GitHub Actions secrets, etc.).  NEVER commit a real .env
# file – it is excluded via .gitignore and .dockerignore.
# =============================================================================

# ---- Django core ------------------------------------------------------------
SECRET_KEY=change-me-to-a-50-character-random-string-please
DEBUG=False
ALLOWED_HOSTS=fitforge.app,www.fitforge.app
CSRF_TRUSTED_ORIGINS=https://fitforge.app,https://www.fitforge.app
DJANGO_SETTINGS_MODULE=config.settings.production
PORT=8000

# ---- Database (Supabase Postgres or any managed PG) -------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fitforge

# ---- Cache / broker (managed Redis) ----------------------------------------
REDIS_URL=redis://:PASSWORD@HOST:6379/0
CELERY_BROKER_URL=redis://:PASSWORD@HOST:6379/0
CELERY_RESULT_BACKEND=redis://:PASSWORD@HOST:6379/0
CELERY_TIMEZONE=UTC

# ---- Sessions / cookies (production only) ----------------------------------
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Observability ---------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=False
ENABLE_PROMETHEUS=True

# ---- Feature flags ---------------------------------------------------------
CSP_UPGRADE_INSECURE_REQUESTS=True
USE_CELERY_BEAT=False
ENABLE_SILK=False

# ---- External APIs ---------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ---- Supabase --------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Social auth – Google --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Social auth – Microsoft -----------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ---- Social auth – Apple ---------------------------------------------------
APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
# Replace newlines with literal ``\n`` when populating this from a YAML /
# JSON secret store, OR set the env var to the multiline PEM value.
APPLE_PRIVATE_KEY=

# ---- Email (transactional) ------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FitForge <no-reply@fitforge.app>
